rules_version = '2';
// Ayiti Nouvo Kontra Sosyal: Public Voice
// Privacy design: the public can only CREATE, UPDATE or DELETE their own answers. Nobody outside the review team
// can read people, emails or submissions. Document ids are SHA-256 hashes of a private code that only the
// person holds, so only they can find their documents again. The public reads only two things the review team
// publishes: aggregated results (groups under the minimum size are removed before publishing) and revision logs.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function s(v, lo, hi) { return v is string && v.size() >= lo && v.size() <= hi; }
    function optInt(v) { return v == null || (v is number && v >= 0 && v <= 120); }

    function validPerson() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name','country','lives','departement','commune','occupation','occupationOther','yearsThere','yearsSinceLeft','ageRange','at'])
        && d.keys().hasAll(['name','country','lives','departement','commune','occupation','occupationOther','yearsThere','yearsSinceLeft','ageRange','at'])
        && s(d.name, 2, 120) && s(d.country, 2, 2) && d.lives in ['ayiti','abroad']
        && ((d.country == 'HT') == (d.lives == 'ayiti'))
        && s(d.departement, 0, 40) && s(d.commune, 1, 120)
        && d.occupation in ['Farmer','Fisher','Market trader','Teacher or professor','Health worker','Student','Public servant','Police or army','Lawyer or judge','Business owner','Engineer or technology worker','Builder or artisan','Driver or transport worker','Domestic worker','Religious leader','Journalist or media','Unemployed','Retired','Other']
        && s(d.occupationOther, 0, 120)
        && optInt(d.yearsThere) && optInt(d.yearsSinceLeft)
        && (d.ageRange == null || d.ageRange in ['under25','25-34','35-49','50-64','65plus'])
        && d.at == request.time;
    }

    function validEmail() {
      let d = request.resource.data;
      return d.keys().hasOnly(['email','mayContact','live','at']) && d.keys().hasAll(['email','mayContact','at'])
        && (!('live' in d.keys()) || d.live is bool)
        && s(d.email, 5, 200) && d.email.matches('^[^@ ]+@[^@ ]+\\.[^@ ]+$')
        && d.mayContact is bool && d.at == request.time;
    }

    function validSubmission() {
      let d = request.resource.data;
      return d.keys().hasOnly(['pid','part','vote','comment','commentLang','wording','uiLang','status','at'])
        && d.keys().hasAll(['pid','part','vote','comment','commentLang','wording','uiLang','status','at'])
        && s(d.pid, 64, 64) && d.part is int && d.part >= 0 && d.part <= 47
        && d.vote in ['approve','changes','disapprove']
        && s(d.comment, 0, 5000) && (d.vote == 'approve' || d.comment.size() >= 3)
        && d.commentLang in ['en','ht','fr','es','pt','other']
        && s(d.wording, 0, 5000) && s(d.uiLang, 2, 2)
        && d.status == 'new' && d.at == request.time;
    }

    // Live room access. The document id is the same secret hash as the person's other documents, so only the
    // holder of the code can read it by id; nobody can list them except the review team. Access ends on the
    // cycle date the review team sets in public/cycle. It cannot be created without a people and an emails document.
    function cycleEnd() { return get(/databases/$(database)/documents/public/cycle).data.end; }
    function validAccess(pid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['until','at']) && d.keys().hasAll(['until','at'])
        && d.at == request.time && d.until == cycleEnd() && request.time < cycleEnd()
        && existsAfter(/databases/$(database)/documents/people/$(pid))
        && existsAfter(/databases/$(database)/documents/emails/$(pid));
    }

    match /access/{pid} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if validAccess(pid);
      allow update: if isAdmin() || (resource.data.until <= request.time && validAccess(pid));
      allow delete: if true;
    }
    match /people/{pid} {
      allow read: if isAdmin();
      allow create, update: if validPerson();
      allow delete: if true;
    }
    match /emails/{pid} {
      allow read: if isAdmin();
      allow create, update: if validEmail();
      allow delete: if true;
    }
    match /submissions/{sid} {
      allow read: if isAdmin();
      allow create: if validSubmission();
      allow update: if isAdmin() || validSubmission();
      allow delete: if true;
    }
    // published by the review team only
    match /public/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /revisions/{part} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{doc} {
      allow read, write: if isAdmin();
    }
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;   // add the first admin by hand in the console
    }
    // Document downloads (read.html). A reader signs in with email and password, saves a profile, and every
    // download writes one record. Readers can read only their own profile. Only the review team reads the log.
    function validReader() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name','email','country','mayContact','at']) && d.keys().hasAll(['name','email','country','mayContact','at'])
        && s(d.name, 2, 120) && s(d.country, 2, 60) && d.mayContact is bool
        && d.email == request.auth.token.email && d.at == request.time;
    }
    function validDownload() {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid','name','email','country','part','lang','at']) && d.keys().hasAll(['uid','name','email','country','part','lang','at'])
        && d.uid == request.auth.uid && d.email == request.auth.token.email
        && s(d.name, 2, 120) && s(d.country, 2, 60)
        && d.part is int && d.part >= 0 && d.part <= 110      // 0 = the full document
        && d.lang in ['en','ht'] && d.at == request.time
        && exists(/databases/$(database)/documents/readers/$(request.auth.uid));
    }
    match /readers/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid && validReader();
      allow delete: if isAdmin();
    }
    match /downloads/{id} {
      allow create: if request.auth != null && validDownload();
      allow read, delete: if isAdmin();
      allow update: if false;
    }
    // Konbit 3,5% (join/). A member signs in with a verified email, creates one member record, and in the
    // same batch adds 1 to the public tally of their place. Only counts are public; names never are.
    function placeOk(p) { return p in ['c_anse_a_galets','c_arcahaie','c_cabaret','c_carrefour','c_cite_soleil','c_cornillon','c_croix_des_bouquets','c_delmas','c_fonds_verrettes','c_ganthier','c_grand_goave','c_gressier','c_kenscoff','c_leogane','c_petion_ville','c_petit_goave','c_pointe_a_raquette','c_port_au_prince','c_tabarre','c_thomazeau','c_anse_rouge','c_desdunes','c_dessalines','c_ennery','c_gonaives','c_grande_saline','c_gros_morne','c_l_estere','c_la_chapelle','c_marmelade','c_petite_riviere_de_l_artibonite','c_saint_marc','c_saint_michel_de_l_attalaye','c_terre_neuve','c_verrettes','c_acul_du_nord','c_bahon','c_bas_limbe','c_borgne','c_cap_haitien','c_dondon','c_grande_riviere_du_nord','c_la_victoire','c_limbe','c_limonade','c_milot','c_pignon','c_pilate','c_plaine_du_nord','c_plaisance','c_port_margot','c_quartier_morin','c_ranquitte','c_saint_raphael','c_aquin','c_arniquet','c_camp_perrin','c_cavaillon','c_chantal','c_chardonnieres','c_coteaux','c_ile_a_vache','c_les_anglais','c_les_cayes','c_maniche','c_port_salut','c_port_a_piment','c_roche_a_bateaux','c_saint_jean_du_sud','c_saint_louis_du_sud','c_tiburon','c_torbeck','c_belladere','c_boucan_carre','c_cerca_carvajal','c_cerca_la_source','c_hinche','c_lascahobas','c_maissade','c_mirebalais','c_saut_d_eau','c_savanette','c_thomassique','c_thomonde','c_anse_a_foleur','c_baie_de_henne','c_bassin_bleu','c_bombardopolis','c_chansolme','c_jean_rabel','c_la_tortue','c_mole_saint_nicolas','c_port_de_paix','c_saint_louis_du_nord','c_anse_a_pitres','c_bainet','c_belle_anse','c_cayes_jacmel','c_cotes_de_fer','c_grand_gosier','c_jacmel','c_la_vallee_de_jacmel','c_marigot','c_thiotte','c_abricots','c_anse_d_hainault','c_beaumont','c_bonbon','c_chambellan','c_corail','c_dame_marie','c_jeremie','c_les_irois','c_moron','c_pestel','c_roseaux','c_capotille','c_caracol','c_carice','c_ferrier','c_fort_liberte','c_mombin_crochu','c_mont_organise','c_ouanaminthe','c_perches','c_sainte_suzanne','c_terrier_rouge','c_trou_du_nord','c_vallieres','c_anse_a_veau','c_arnaud','c_baraderes','c_fonds_des_negres','c_grand_boucan','c_l_asile','c_miragoane','c_paillant','c_petit_trou_de_nippes','c_petite_riviere_de_nippes','c_plaisance_du_sud','d_us','d_ca','d_fr','d_do','d_cl','d_br','d_bs','d_gb','d_mx','d_gp','d_ot']; }
    function memberPath(uid) { return /databases/$(database)/documents/members/$(uid); }
    function tallyPath(d) { return /databases/$(database)/documents/tally/$(d); }
    function validMember() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name','email','dep','place','section','phone','voter','organizer','ref','adult','pledge','mayContact','at'])
        && d.keys().hasAll(['name','email','dep','place','section','phone','voter','organizer','ref','adult','pledge','mayContact','at'])
        && s(d.name, 2, 120) && d.email == request.auth.token.email
        && d.dep in ['ouest','artibonite','nord','sud','centre','nordouest','sudest','grandanse','nordest','nippes','dia']
        && placeOk(d.place) && ((d.dep == 'dia') == d.place.matches('d_.*'))
        && s(d.section, 0, 80) && s(d.phone, 0, 30) && d.voter in ['yes','no','will']
        && d.organizer is bool && s(d.ref, 0, 12) && d.adult == true && d.pledge == true && d.mayContact is bool;
    }
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    // One tally document per département (and 'dia'), with one number per commune or country.
    function countBefore(d, p) { return exists(tallyPath(d)) ? get(tallyPath(d)).data.get(p, 0) : 0; }
    function countAfter(d, p) { return getAfter(tallyPath(d)).data.get(p, 0); }
    match /members/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if verified() && request.auth.uid == uid && validMember() && request.resource.data.at == request.time
        && countAfter(request.resource.data.dep, request.resource.data.place) == countBefore(request.resource.data.dep, request.resource.data.place) + 1;
      allow update: if request.auth != null && request.auth.uid == uid && validMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['section','phone','voter','organizer','mayContact']);
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid
        && countAfter(resource.data.dep, resource.data.place) == countBefore(resource.data.dep, resource.data.place) - 1);
    }
    function joining(d) {
      return request.auth != null && !exists(memberPath(request.auth.uid)) && existsAfter(memberPath(request.auth.uid))
        && getAfter(memberPath(request.auth.uid)).data.dep == d;
    }
    function joinedPlace() { return getAfter(memberPath(request.auth.uid)).data.place; }
    function leaving(d) {
      return request.auth != null && exists(memberPath(request.auth.uid)) && !existsAfter(memberPath(request.auth.uid))
        && get(memberPath(request.auth.uid)).data.dep == d;
    }
    function leftPlace() { return get(memberPath(request.auth.uid)).data.place; }
    match /tally/{d} {
      allow get, list: if true;
      allow create: if joining(d) && request.resource.data.keys().hasOnly([joinedPlace()]) && request.resource.data.get(joinedPlace(), 0) == 1;
      allow update: if isAdmin()
        || (joining(d) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([joinedPlace()])
            && request.resource.data.get(joinedPlace(), 0) == resource.data.get(joinedPlace(), 0) + 1)
        || (leaving(d) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([leftPlace()])
            && request.resource.data.get(leftPlace(), 0) == resource.data.get(leftPlace(), 0) - 1);
      allow delete: if isAdmin();
    }
    match /accessLog/{id} {
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['uid','action','at']) && request.resource.data.at == request.time;
      allow read: if isAdmin();
    }
  }
}
